# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — veja o guia completo em docs/SUPABASE.md
# 1) Crie o projeto em https://supabase.com
# 2) Project Settings → API → copie Project URL e anon public key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Não coloque no frontend (só scripts admin futuros)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth MCP — somente no servidor/Vercel Preview; nunca NEXT_PUBLIC_
OAUTH_ISSUER=https://SEU-PREVIEW.vercel.app
OAUTH_JWT_KEY_ID=gdfinances-preview-1
OAUTH_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----
OAUTH_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----

# AI (Etapa 8)
OPENAI_API_KEY=
